# Primary Index（可选。无付费 Key 时保持 false，分析走 Solana RPC / Helius）
ENABLE_MORALIS=false
MORALIS_API_KEY=
MORALIS_API_KEYS=
MORALIS_API_BASE=https://solana-gateway.moralis.io

# Chain Authority
# 公共 RPC 以 Solana 官方文档为准：https://solana.com/docs/rpc
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Enhance
HELIUS_API_KEY=
HELIUS_API_KEYS=
HELIUS_RPC_URL=
HELIUS_TARGET_RPS=8
HELIUS_MONTHLY_CREDIT_BUDGET=1000000
HELIUS_API_WORKERS=4

# Auxiliary Verification
GMGN_API_KEY=
GMGN_API_KEYS=
GMGN_API_BASE=https://openapi.gmgn.ai
ENABLE_GMGN=true
ENABLE_GMGN_DEEP_HISTORY_FALLBACK=false
# automation = gmgn.ai Cookie 号池 + 浏览器；api = OpenAPI Key
GMGN_COLLECTION_MODE=automation
GMGN_BROWSER_HEADED=true
GMGN_QR_LOGIN_TIMEOUT=180

# Verification
VERIFICATION_MODE=BALANCED

# 每个 Key 独立限额（Free 默认 5 weighted units / 秒）
GMGN_KEY_RATE=5
GMGN_KEY_CAPACITY=5
GMGN_MAX_TARGET_UTILIZATION=0.80
GMGN_INITIAL_UTILIZATION=0.60
GMGN_TARGET_UTILIZATION=0.75
GMGN_RESET_SAFETY_MARGIN=3
GMGN_API_WORKERS=4
GMGN_SHARED_LIMIT_DETECTION=true
GMGN_PLAN=Free

# 兼容旧字段
GMGN_RATE=5
GMGN_CAPACITY=5
GMGN_RATE_LIMIT_RATE=5
GMGN_RATE_LIMIT_CAPACITY=5

# Token Info 缓存 TTL（秒），默认 12 小时
TOKEN_INFO_CACHE_TTL=43200
TOKEN_INFO_TTL_SECONDS=43200
TOKEN_POOL_TTL_SECONDS=1800
WALLET_STATS_CACHE_TTL=180

GMGN_429_MAX_RETRIES=8
GMGN_MAX_API_WAIT=900

# DEX Screener 当前官方公开接口不需要 Key。
